# Copy to server/.env and fill in. NEVER commit the real .env.

# Telegram bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=

# OpenRouter API key for AI reply drafting (optional — fallback drafts if empty)
OPENROUTER_API_KEY=

# Any OpenRouter model; a free instruct model is fine for drafts
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

PORT=8787
